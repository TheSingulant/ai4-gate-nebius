# Copy to .env and fill in. Do not commit .env. Leave the key empty to run the SCRIPTED planner.

# auto: Nemotron when NEBIUS_API_KEY is set, otherwise the SCRIPTED planner.
# scripted: never call Nebius. nebius: require the key.
PLANNER=auto
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# nvidia/nemotron-3-super-120b-a12b leaves serverless on 2026-11-09.
# nvidia/Nemotron-3_5-Lightning also passed live tests but varied across runs.
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# This edition only includes the open reference authorizer.
AUTHORIZER=reference
GATE_DB=
GATE_POLICY=
GATE_SIGNING_KEY_FILE=
GATE_APPROVER_KEY_FILE=

HOST=127.0.0.1
PORT=8000

# Public demo limits. A restart does not reset the daily cap when GATE_BUDGET_DB is a file.
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=40
MAX_CONCURRENT_AGENTS=2
GATE_IP_MUTATION_RATE_PER_MIN=20
GATE_GLOBAL_MUTATION_RATE_PER_MIN=60
GATE_IP_READ_RATE_PER_MIN=240
GATE_GLOBAL_READ_RATE_PER_MIN=800
GATE_DAILY_REQUEST_BUDGET=40
GATE_DAILY_TOKEN_BUDGET=200000
GATE_DAILY_AGENT_RUNS=100
GATE_BUDGET_DB=
GATE_SESSION_ROOT=
# Set to 1 only behind a proxy you trust to set X-Forwarded-For.
GATE_TRUST_PROXY=0

# guided: hosted preview. Visitors pick a preset scenario. Free-text tasks are refused.
# open: local development only. Do not use open on a public host.
GATE_MODE=guided
# Minimum seconds between live Nemotron runs in one session. The next run is SCRIPTED.
GATE_LIVE_INTERVAL_SECONDS=600

# Optional private preview. Leave empty for open local use.
# When set (at least 8 characters), every route except /health requires
# Authorization: Bearer <token> or HTTP basic auth with this password.
PREVIEW_ACCESS_TOKEN=
# Set to 1 behind HTTPS (the compose file does). Leave unset for local HTTP.
PREVIEW_HSTS=0

# Optional independent judge credential (separate authentication only).
# Both must be set. Token must be at least 32 characters. Expiry is RFC 3339 UTC
# with a Z suffix, checked on every request (valid while now < expiry).
# Requires PREVIEW_ACCESS_TOKEN; startup refuses if judge is set without it, or if
# the two token values are identical. Leave both empty to disable (open local dev).
# Clearing JUDGE_ACCESS_TOKEN and restarting revokes judges without changing
# PREVIEW_ACCESS_TOKEN. Judges stay in guided mode.
JUDGE_ACCESS_TOKEN=
JUDGE_TOKEN_EXPIRES_AT=

SANDBOX_PYTHON_TIMEOUT=8
SANDBOX_TESTS_TIMEOUT=20
SANDBOX_CPU_SECONDS=5
SANDBOX_MEMORY_BYTES=268435456
SANDBOX_OUTPUT_CHARS=4000
SANDBOX_MAX_WRITE_BYTES=65536
